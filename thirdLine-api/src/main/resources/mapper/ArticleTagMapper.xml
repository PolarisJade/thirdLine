<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.god.thirdLine.mapper.ArticleTagMapper">

    <!-- 批量建立文章与标签的关联：一条 INSERT 解决，避免在循环里逐条 insert -->
    <insert id="insertBatch">
        INSERT INTO tl_article_tag (article_id, tag_id) VALUES
        <foreach collection="relations" item="item" separator=",">
            (#{item.articleId}, #{item.tagId})
        </foreach>
    </insert>

</mapper>
